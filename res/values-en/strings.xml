    <!-- Onboarding -->
    <string name="onboarding_intro">The productivity bar at your screen edge.\n\nSet up once, everything then lives in the bar itself: a handle appears at the edge – tap it or swipe toward the middle to pull it out, swipe back to close it. Settings sit at the top as their own card.\n\nThree permissions are needed to get started:</string>
    <string name="onboarding_step1">1. Display over other apps</string>
    <string name="onboarding_step2">2. Notification access (for the inbox)</string>
    <string name="onboarding_step3">3. Calendar</string>
    <string name="allow_button">Allow</string>
    <string name="onboarding_footer">\nOnce all three are granted, the bar opens automatically – and this screen won\'t appear again.</string>

